@prefix evrepo: <https://vocab.evidence-repository.org/> .
@prefix dsny:   <https://vocab.destiny-evidence.org/> .
@prefix gn:     <http://www.geonames.org/ontology#> .
@prefix geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# GeoNames place mentions — standalone test vocabulary
#
# Self-contained: import into an EMPTY scratch project (not DESTINY) to try the
# geoparsing robot's linked-data output end to end. Contains the minimal
# evrepo-core subset the mention shape needs, plus everything in
# geonames-location.ttl verbatim (a test keeps the two in step).
#
# Shape: Investigation -mentionedPlace-> LocationCodingAnnotation
#        -codedValue-> gn:GeonamesFeature (http://sws.geonames.org/{id}/)
#
# Write status as the compact IRI "evrepo:coded" in data, not bare "coded"
# (see taxonomy-builder context generation: status is "@type": "@id").
# =============================================================================


# --- evrepo-core subset (existing terms, verbatim from evrepo-core.ttl) ---
# Exception: supportingText and codedBy have their domain narrowed to
# CodingAnnotation, because the core's union domain names ObservedResult and
# EffectEstimate, which this subset leaves out.

evrepo:Investigation a owl:Class ;
    rdfs:label "Investigation"@en ;
    rdfs:comment "A study reported within a Reference. An Investigation produces one or more Findings."@en .

evrepo:CodingAnnotation a owl:Class ;
    rdfs:label "Coding Annotation"@en ;
    rdfs:comment "A coded value with provenance from source material. Wraps each coded property value with supporting text, coder identity, and coding status."@en .

evrepo:codedValue a rdf:Property ;
    rdfs:label "coded value"@en ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:comment "The extracted value. Type varies by CodingAnnotation subclass."@en .

evrepo:supportingText a rdf:Property ;
    rdfs:label "supporting text"@en ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:range xsd:string ;
    rdfs:comment "Verbatim or near-verbatim text from the source material that supports the coded value."@en .

evrepo:codedBy a rdf:Property ;
    rdfs:label "coded by"@en ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:comment "The agent (human coder or LLM) who performed the coding."@en .

evrepo:CodingStatus a owl:Class ;
    rdfs:label "Coding Status"@en ;
    rdfs:comment "The lifecycle state of a coding annotation."@en ;
    owl:oneOf ( evrepo:coded evrepo:notApplicable evrepo:notReported ) .

evrepo:coded a owl:NamedIndividual , evrepo:CodingStatus ;
    rdfs:label "Coded"@en ;
    rdfs:comment "A codedValue is present — the field has been coded from the source."@en .

evrepo:notApplicable a owl:NamedIndividual , evrepo:CodingStatus ;
    rdfs:label "Not Applicable"@en ;
    rdfs:comment "The coder determined the field is irrelevant to this finding (e.g. effect size for a qualitative study). No codedValue is expected."@en .

evrepo:notReported a owl:NamedIndividual , evrepo:CodingStatus ;
    rdfs:label "Not Reported"@en ;
    rdfs:comment "The required information is not disclosed in the source material. No codedValue is expected."@en .

evrepo:status a owl:ObjectProperty ;
    rdfs:label "status"@en ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:range evrepo:CodingStatus ;
    rdfs:comment "The lifecycle state of this coding annotation."@en .


# --- evrepo-core additions (new; also in evrepo-core.ttl) ---

evrepo:mentionText a owl:DatatypeProperty ;
    rdfs:label "mention text"@en ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:range xsd:string ;
    rdfs:comment "The exact span of source text that was coded (e.g. the place name as written). supportingText carries the surrounding context."@en .

evrepo:startChar a owl:DatatypeProperty ;
    rdfs:label "start character"@en ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:range xsd:integer ;
    rdfs:comment "0-based Unicode code point offset where mentionText starts in the source text."@en .

evrepo:endChar a owl:DatatypeProperty ;
    rdfs:label "end character"@en ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:range xsd:integer ;
    rdfs:comment "Exclusive 0-based Unicode code point offset where mentionText ends in the source text."@en .

evrepo:codingScore a owl:DatatypeProperty ;
    rdfs:label "coding score"@en ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Score the coder (see codedBy) assigned to this coding. Scale and meaning depend on the coder; not a calibrated probability unless the coder documents it as one."@en .


# --- GeoNames terms (subset of http://www.geonames.org/ontology) ---
# GeoNames requires exactly one geonamesID, name, geo:lat, geo:long and
# featureClass on a GeonamesFeature, and at most one featureCode and
# countryCode. taxonomy-builder drops cardinality restrictions on import, so
# they are not restated here; producers should still emit all of them.
# gn:name is not declared (identifier clash with evrepo:name, see
# taxonomy-builder#268) but should be emitted as the compact IRI "gn:name".

gn:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    rdfs:comment "A geographical feature, as defined by the GeoNames ontology."@en .

gn:GeonamesFeature a owl:Class ;
    rdfs:subClassOf gn:Feature ;
    rdfs:label "Geonames Feature"@en ;
    rdfs:comment "A feature described in geonames database, uniquely defined by its geonames identifier"@en .

gn:Class a owl:Class ;
    rdfs:label "Feature Class"@en ;
    rdfs:comment "GeoNames feature class (gn:A country/region, gn:H water, gn:L area, gn:P populated place, gn:R road, gn:S spot, gn:T terrain, gn:U undersea, gn:V vegetation)."@en .

gn:Code a owl:Class ;
    rdfs:label "Feature Code"@en ;
    rdfs:comment "GeoNames feature code, e.g. gn:A.PCLI (independent political entity) or gn:P.PPL (populated place)."@en .

gn:countryCode a owl:DatatypeProperty ;
    rdfs:label "country code"@en ;
    rdfs:domain gn:Feature ;
    rdfs:range xsd:string ;
    rdfs:comment "ISO 3166-1 alpha-2 country code of the feature (e.g. IN). Not alpha-3."@en .

gn:geonamesID a owl:DatatypeProperty ;
    rdfs:label "GeoNames ID"@en ;
    rdfs:domain gn:Feature ;
    rdfs:range xsd:string ;
    rdfs:comment "The GeoNames identifier (geonameid) of the feature, e.g. 1269750. Duplicates the last path segment of the feature URI so it can be matched without parsing the URI."@en .

gn:featureClass a owl:ObjectProperty ;
    rdfs:label "feature class"@en ;
    rdfs:domain gn:Feature ;
    rdfs:range gn:Class ;
    rdfs:comment "The GeoNames feature class of the feature."@en .

gn:featureCode a owl:ObjectProperty ;
    rdfs:label "feature code"@en ;
    rdfs:domain gn:Feature ;
    rdfs:range gn:Code ;
    rdfs:comment "The GeoNames feature code of the feature."@en .


# --- W3C Basic Geo terms (http://www.w3.org/2003/01/geo/wgs84_pos#) ---
# Declared with W3C's domain (SpatialThing) and no range, rather than narrowed
# to gn:Feature, so we don't assert more about these terms than W3C does.

geo:SpatialThing a owl:Class ;
    rdfs:label "Spatial Thing"@en ;
    rdfs:comment "Anything with spatial extent, i.e. size, shape, or position (W3C Basic Geo)."@en .

geo:lat a owl:DatatypeProperty ;
    rdfs:label "latitude"@en ;
    rdfs:domain geo:SpatialThing ;
    rdfs:comment "WGS84 latitude in decimal degrees."@en .

geo:long a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:domain geo:SpatialThing ;
    rdfs:comment "WGS84 longitude in decimal degrees."@en .


# --- DESTINY terms ---

dsny:LocationCodingAnnotation a owl:Class ;
    rdfs:subClassOf evrepo:CodingAnnotation ;
    rdfs:label "Location Coding Annotation"@en ;
    rdfs:comment "A single mention of a place in the source text, resolved to a GeoNames feature. Provenance (supportingText, mentionText, startChar, endChar, codingScore, codedBy) is per mention."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty evrepo:codedValue ;
        owl:allValuesFrom gn:GeonamesFeature
    ] .

dsny:mentionedPlace a owl:ObjectProperty ;
    rdfs:label "mentioned place"@en ;
    rdfs:domain evrepo:Investigation ;
    rdfs:range dsny:LocationCodingAnnotation ;
    rdfs:comment "A place mentioned in the reference's text. A mention is not necessarily where the study was conducted."@en ;
    dsny:allowMultiple true .
